# Copy this file to ".env" and fill in real values.
# The ".env" file is listed in .gitignore, so it never goes to GitHub.

# Django secret key - change this to a long random string
SECRET_KEY=change-me-to-a-long-random-string

# Turn this off (False) when you put the site on a real server
DEBUG=True

# Hosts allowed to serve this site, separated by commas
ALLOWED_HOSTS=127.0.0.1,localhost

# Your Groq API key from https://console.groq.com/keys
# The AI chat, translation, image recognition and speech-to-text need this.
GROQ_API_KEY=

# Which Groq models to use. The defaults below are already set in
# settings.py, so you only need these lines if you want to change them.
# Run "python manage.py check_ai" to see what your account can access.

# Chat and translation
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Image recognition (must be a model that can see pictures)
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Speech to text
GROQ_WHISPER_MODEL=whisper-large-v3
