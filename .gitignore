# Secrets - NEVER commit this
.env

# Python
venv/
__pycache__/
*.py[cod]
*.egg-info/

# Django
db.sqlite3
db.sqlite3-journal
/media/

# NOTE: staticfiles/ is deliberately NOT ignored.
# Vercel has no build shell to run collectstatic, so the collected
# static files are committed and served by WhiteNoise from inside
# the serverless function. Re-run collectstatic after changing
# anything in static/ and commit the result.

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Added when the project was linked to Vercel: local project link and the
# pulled environment file. ".env.example" stays tracked on purpose - it is
# the documentation of which variables the app needs.
.vercel
.env*
!.env.example
